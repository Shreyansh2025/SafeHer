# Copy this file to .env and fill in YOUR values. Never commit .env.
PORT=3000
DB_NAME=safeher
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
JWT_SECRET=
ADMIN_JWT_SECRET=

# Only used by `npm run smoke` (the admin login hardcoded in services/adminService.js). The app itself ignores these.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_CONTENT_SID=
TWILIO_TWIML_BIN_URL=


# Vonage
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=

VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY=
VONAGE_VOICE_FROM=
VONAGE_REGISTERED_PHONE=

# How long a guardian link stays valid (hours)
GUARDIAN_WEB_URL=
GUARDIAN_LINK_TTL_HOURS=24
