# Copy this file to .env and fill in YOUR values. Never commit .env.
PORT=3000
DB_NAME=safeher
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
JWT_SECRET=change-me-user-token-secret-safeher
ADMIN_JWT_SECRET=change-me-different-admin-token-secret-safeher

# Only used by `npm run smoke` (the admin login hardcoded in services/adminService.js). The app itself ignores these.
ADMIN_EMAIL=
ADMIN_PASSWORD=
